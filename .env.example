# 复制为 .env 后按需修改。.env 已被 gitignore，切勿提交。
# 生产环境不使用本文件，全部走环境变量 / 密钥管理服务（见 _design/07-security-privacy.md）。

# ── PostgreSQL ────────────────────────────────────
POSTGRES_PORT=5432
POSTGRES_PASSWORD=devonly_change_me

# ── Mailpit（本地 SMTP 捕获）────────────────────────
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ── MinIO（对象存储）───────────────────────────────
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=nimpression
MINIO_ROOT_PASSWORD=devonly_change_me

# ── 应用 ──────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5080
WEB_PORT=4200
